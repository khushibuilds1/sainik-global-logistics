# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────
# Replace <username>, <password>, <cluster> with your Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ── Email (Gmail with App Password) ──────────────────────────
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
NOTIFY_EMAIL=sales@sainikglobal.com

# ── Admin Seed ───────────────────────────────────────────────
ADMIN_EMAIL=admin@sainikglobal.com
ADMIN_PASSWORD=Sainik@2024!

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://sainikglobal.com
